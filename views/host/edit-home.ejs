<%- include('../partials/head') %>
</head>
<body>
    <%- include('../partials/nav') %>
    <main>
        <section class="form-card">
            <h2><%= editing ? 'Edit Your Home' : 'Add a New Home' %></h2>
            <form action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST" enctype="multipart/form-data" >
                <input type="hidden" name="homeID" value="<%= editing ? home._id : '' %>" >
                <input type="text" name="houseName" placeholder="House name" value="<%= editing ? home.houseName : '' %>" required>
                <input type="text" name="location" placeholder="Location" value="<%= editing ? home.location : '' %>" required>
                <input type="number" name="price" placeholder="Price per night (USD)" value="<%= editing ? home.price : '' %>" required min="0" step="0.01">
                <input type="number" name="rating" placeholder="Rating (0–5)" value="<%= editing ? home.rating : '' %>" required min="0" max="5" step="0.5">
                
                <div class="form-group">
                    <label for="photo">Upload Photo (JPG, JPEG, PNG)</label>
                    <input type="file" name="photo" id="photo" accept="image/jpg, image/jpeg, image/png">
                </div>
                
                <div class="form-group">
                    <label for="houseRules">Upload House Rules (PDF)</label>
                    <input type="file" name="houseRules" id="houseRules" accept=".pdf">
                </div>
                
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea placeholder="Describe your home..." name="description"><%= editing ? home.description : '' %></textarea>
                </div>
                
                <button type="submit"><%= editing ? "Update Home" : "Add Home" %></button>
            </form>
        </section>
    </main>
</body>
</html>
