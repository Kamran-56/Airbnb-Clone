<%- include('../partials/head') %>
    </head>

    <body>

        <%- include('../partials/nav') %>

            <main>

                <h1 class="page-heading">My Favorites:</h1>

                <section class="form-card">

                    <ul class="home-list">
                        <% if (favHomes.length===0) { %>
                            <li class="empty">Your favourite homes appear here</li>
                            <% } else { %>
                                 <% favHomes.forEach((home) => { %>
                                    <li class="home-card">
                                        <div class="card-media">
                                            <img src="<%= home.photoUrl || 'https://via.placeholder.com/560x350?text=No+Photo' %>"
                                                alt="<%= home.houseName %>">
                                        </div>
                                        <div class="card-content">
                                            <h3>
                                                <%= home.houseName %>
                                            </h3>
                                            <div class="card-meta">
                                                <span class="location"><strong>Location:</strong>
                                                    <%= home.location %>
                                                </span>
                                                <span class="price">$<%= home.price %> / night</span>
                                            </div>
                                            <p class="rating">Rating: <strong>
                                                    <%= home.rating %> / 5
                                                </strong></p>
                                        </div>
                                        <form action="/fav-list/delete/<%= home._id %>" method="POST">
                                            <button type="submit" id="removeFav">Remove from Fav</button>
                                        </form>
                                    </li>
                                    <% }); %>
                                        <% } %>
                    </ul>
                </section>

            </main>

    </body>

    </html>


   
